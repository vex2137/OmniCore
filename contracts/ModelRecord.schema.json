    "size_bytes": {
      "minimum": 0,
      "title": "Size Bytes",
      "type": "integer"
    },
    "tested_backends": {
      "items": {
        "type": "string"
      },
      "maxItems": 32,
      "title": "Tested Backends",
      "type": "array"
