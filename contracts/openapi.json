{
  "components": {
    "schemas": {
      "BackendInfo": {
        "additionalProperties": false,
        "properties": {
          "available": {
            "title": "Available",
            "type": "boolean"
          },
          "capabilities": {
            "items": {
              "$ref": "#/components/schemas/Capability"
            },
            "title": "Capabilities",
            "type": "array"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "resources": {
            "$ref": "#/components/schemas/ResourceUsage"
          },
          "version": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Version"
          }
        },
        "required": [
          "id",
          "available"
        ],
        "title": "BackendInfo",
        "type": "object"
      },
      "Capability": {
        "enum": [
          "text",
          "vision",
          "text_to_image",
          "image_to_image",
          "inpaint",
          "upscale",
          "lora"
        ],
        "title": "Capability",
        "type": "string"
      },
      "ErrorDetail": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorDetail",
        "type": "object"
      },
      "ErrorResponse": {
        "additionalProperties": false,
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          }
        },
        "required": [
          "error"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "Health": {
        "additionalProperties": false,
        "properties": {
          "database_version": {
            "title": "Database Version",
            "type": "integer"
          },
          "status": {
            "const": "ok",
            "default": "ok",
            "title": "Status",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "version",
          "database_version"
        ],
        "title": "Health",
        "type": "object"
      },
      "InterfaceMode": {
        "enum": [
          "simple",
          "advanced"
        ],
        "title": "InterfaceMode",
        "type": "string"
      },
      "Locale": {
        "enum": [
          "en-US",
          "pl-PL"
        ],
        "title": "Locale",
        "type": "string"
      },
      "LocaleCatalog": {
        "additionalProperties": false,
        "properties": {
          "locale": {
            "$ref": "#/components/schemas/Locale"
          },
          "messages": {
            "additionalProperties": {
              "type": "string"
            },
            "title": "Messages",
            "type": "object"
          }
        },
        "required": [
          "locale",
          "messages"
        ],
        "title": "LocaleCatalog",
        "type": "object"
      },
      "Preferences": {
        "additionalProperties": false,
        "properties": {
          "locale": {
            "$ref": "#/components/schemas/Locale",
            "default": "en-US"
          },
          "mode": {
            "$ref": "#/components/schemas/InterfaceMode",
            "default": "simple"
          },
          "schema_version": {
            "const": 1,
            "default": 1,
            "title": "Schema Version",
            "type": "integer"
          },
          "theme": {
            "$ref": "#/components/schemas/Theme",
            "default": "system"
          }
        },
        "title": "Preferences",
        "type": "object"
      },
      "ResourceUsage": {
        "additionalProperties": false,
        "properties": {
          "ram_bytes": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Ram Bytes"
          },
          "vram_bytes": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Vram Bytes"
          }
        },
        "title": "ResourceUsage",
        "type": "object"
      },
      "Theme": {
        "enum": [
          "system",
          "light",
          "dark"
        ],
        "title": "Theme",
        "type": "string"
      }
    },
    "securitySchemes": {
      "BearerAuth": {
        "description": "Required remotely and whenever a runtime API token is configured.",
        "scheme": "bearer",
        "type": "http"
      }
    }
