{
  "$defs": {
    "GenerationParameters": {
      "additionalProperties": false,
      "properties": {
        "context_size": {
          "default": 2048,
          "maximum": 131072,
          "minimum": 128,
          "title": "Context Size",
          "type": "integer"
        },
        "device": {
          "default": "cpu",
          "pattern": "^(cpu|auto|[A-Za-z0-9][A-Za-z0-9_.:-]{0,63})$",
          "title": "Device",
          "type": "string"
        },
        "gpu_layers": {
          "default": 0,
          "maximum": 999,
          "minimum": 0,
          "title": "Gpu Layers",
          "type": "integer"
        },
        "max_tokens": {
          "default": 256,
          "maximum": 32768,
          "minimum": 1,
          "title": "Max Tokens",
          "type": "integer"
        },
        "repeat_penalty": {
          "default": 1.1,
          "exclusiveMinimum": 0,
          "maximum": 3,
          "title": "Repeat Penalty",
          "type": "number"
        },
        "seed": {
          "default": 0,
          "maximum": 2147483647,
          "minimum": 0,
          "title": "Seed",
          "type": "integer"
        },
        "system_prompt": {
          "default": "",
          "maxLength": 16384,
          "title": "System Prompt",
          "type": "string"
        },
        "temperature": {
          "default": 0.7,
          "maximum": 2,
          "minimum": 0,
          "title": "Temperature",
          "type": "number"
        },
        "thinking": {
          "default": false,
          "title": "Thinking",
          "type": "boolean"
        },
        "top_k": {
          "default": 40,
          "maximum": 1000,
          "minimum": 0,
          "title": "Top K",
          "type": "integer"
        },
        "top_p": {
          "default": 0.9,
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Top P",
          "type": "number"
        }
      },
      "title": "GenerationParameters",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "content": {
      "default": "",
      "title": "Content",
      "type": "string"
    },
    "context_limit_tokens": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Context Limit Tokens"
    },
    "context_used_tokens": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Context Used Tokens"
    },
    "conversation_id": {
      "title": "Conversation Id",
      "type": "string"
    },
    "created_at": {
      "title": "Created At",
      "type": "string"
    },
    "error_code": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error Code"
    },
    "execution_device": {
      "anyOf": [
        {
          "maxLength": 80,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Execution Device"
    },
    "fallback_reason": {
      "anyOf": [
        {
          "maxLength": 80,
          "pattern": "^[a-zA-Z0-9_.-]+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Fallback Reason"
    },
    "finish_reason": {
      "anyOf": [
        {
          "maxLength": 80,
          "pattern": "^[a-zA-Z0-9_.-]+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Finish Reason"
    },
    "first_answer_seconds": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "First Answer Seconds"
    },
    "generation_seconds": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Generation Seconds"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "input_tokens": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Input Tokens"
    },
    "model_id": {
      "title": "Model Id",
      "type": "string"
    },
    "model_load_seconds": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Model Load Seconds"
    },
    "model_name": {
      "anyOf": [
        {
          "maxLength": 1024,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Model Name"
    },
    "output_tokens": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Output Tokens"
    },
    "parameters": {
      "$ref": "#/$defs/GenerationParameters"
    },
    "reasoning_content": {
      "default": "",
      "maxLength": 1000000,
      "title": "Reasoning Content",
      "type": "string"
    },
    "sequence": {
      "default": 0,
      "title": "Sequence",
      "type": "integer"
    },
    "state": {
      "default": "queued",
      "enum": [
        "queued",
        "running",
        "completed",
        "cancelled",
        "failed",
        "interrupted"
      ],
      "title": "State",
      "type": "string"
    },
    "tokens_per_second": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Tokens Per Second"
    },
    "ttft_seconds": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Ttft Seconds"
    },
    "updated_at": {
      "title": "Updated At",
      "type": "string"
    }
  },
  "required": [
    "id",
    "conversation_id",
    "model_id",
    "parameters",
    "created_at",
    "updated_at"
  ],
  "title": "GenerationRecord",
  "type": "object"
}
