{
  "additionalProperties": false,
  "properties": {
    "filename": {
      "title": "Filename",
      "type": "string"
    },
    "license": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "License"
    },
    "repository": {
      "title": "Repository",
      "type": "string"
    },
    "revision": {
      "title": "Revision",
      "type": "string"
    },
    "sha256": {
      "anyOf": [
        {
          "pattern": "^[a-fA-F0-9]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Sha256"
    },
    "size_bytes": {
      "exclusiveMinimum": 0,
      "title": "Size Bytes",
      "type": "integer"
    }
  },
  "required": [
    "repository",
    "revision",
    "filename",
    "size_bytes"
  ],
  "title": "RemoteFile",
  "type": "object"
}
