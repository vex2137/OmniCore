        }
      },
      "title": "Preferences",
      "type": "object"
    },
    "Theme": {
      "enum": [
        "system",
        "light",
        "dark"
      ],
      "title": "Theme",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "error": {
      "anyOf": [
        {
          "$ref": "#/$defs/ErrorDetail"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "settings": {
      "anyOf": [
        {
          "$ref": "#/$defs/Preferences"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "type": {
      "enum": [
        "hello",
        "settings.updated",
        "pong",
        "error"
      ],
      "title": "Type",
      "type": "string"
    }
  },
  "required": [
    "type"
  ],
  "title": "ServerEvent",
  "type": "object"
}
