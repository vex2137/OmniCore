        },
        "message": {
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "ErrorDetail",
      "type": "object"
    },
    "InterfaceMode": {
      "enum": [
        "simple",
        "advanced"
      ],
      "title": "InterfaceMode",
      "type": "string"
    },
    "Locale": {
      "enum": [
        "en-US",
        "pl-PL"
      ],
      "title": "Locale",
      "type": "string"
    },
    "Preferences": {
      "additionalProperties": false,
      "properties": {
        "locale": {
          "$ref": "#/$defs/Locale",
